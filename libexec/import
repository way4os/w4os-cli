#!/usr/bin/env bash
# opensim import: brings what another install has into this one, through the engine (POST /setups/imports). A simulator of an older
# install joins a grid of this machine, or the settings of an older grid come into the OpenSim.ini of a grid of this machine: planned,
# written with --apply only.

USAGE="opensim import FILE [--apply]
       opensim import --simulator FILE [--simulator FILE...] GRID [--name NAME] [--core DIR] [--apply]
       opensim import --grid-settings FILE GRID [--apply]
       opensim import --accounts FILE GRID [--format csv|json|yaml] [--keep-going] [--result FILE] [--apply]
       opensim import --robust FILE [--nick NICK] [--core DIR] [--simulator FILE...] [--apply] [--switch]"
HELP="Applies a setup file (JSON or YAML: the simulators of a grid of this machine, their regions with name, location, size, roles) to the grid it names, or brings a simulator of another install (its OpenSim.ini, or its file of opensim.d, and the regions it names) into the grid GRID of this machine. Its database is kept as it is (the same one, nothing is copied), its regions are copied with their UUID and their place, its ports and its own settings are kept. Without --apply, says what would be written and where, and writes nothing.
  FILE              a setup file: its simulators are made, or given its regions when the grid has them
  --simulator FILE  the config of a simulator of another install; several, planned together and checked between them (ports,
                    region names and UUIDs, places of the map), written in their order
  --name NAME       its name in the grid, when it is not the one of its config (one simulator only)
  --core DIR        the core it runs with, when it is not the one of the grid (one simulator only)
  --no-scripts      do not copy the state of its scripts (every script starts again from the beginning)
  --grid-settings FILE
                    the OpenSim.ini of a grid of another install: the settings of its options (search, economy and Gloebit,
                    offline messages, profiles, groups), with the files it includes, come into the OpenSim.ini of GRID, where
                    the repair of the options finds them for its simulators; what GRID says already is kept, a secret is masked
  --accounts FILE   a list of accounts to make in GRID: CSV (first, last, email, password, with or without a header line), JSON
                    or YAML (a list of objects with the same keys); the names GRID has are skipped, an account given no
                    password gets one, kept in the result file (mode 600, accounts-result-<date>.csv or --result FILE), never
                    shown; the first failure stops the others, unless --keep-going
  --robust FILE     the Robust config of a grid of another install (Robust.HG.ini, Robust.ini), migrated into this one: the
                    same grid (its database kept as it is, so its accounts and its regions), its config made here with its own
                    settings kept, the old install never changed; --simulator brings its simulators in the same run, --nick
                    and --core when they are not the ones of its config and of this install
  --switch          once the old Robust is stopped: the grid and its simulators enabled and started here (with --apply, or
                    after it)
  --apply           write it (disabled: stop the old one, then opensim enable and opensim start the new one)"

source "$(dirname "$(realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")/../src/lib/common"

files=() grid= name= core= mode=plan scripts=true settings= accounts= format= keep=false robust= nick= switch=false
while (($#)); do
	case "$1" in
	--accounts)
		(($# > 1)) || die "--accounts requires the list of the accounts"
		accounts=$2
		shift 2
		;;
	--accounts=*) accounts=${1#*=}; shift ;;
	--format)
		(($# > 1)) || die "--format requires csv, json or yaml"
		format=$2
		shift 2
		;;
	--format=*) format=${1#*=}; shift ;;
	--keep-going) keep=true; shift ;;
	--robust)
		(($# > 1)) || die "--robust requires the Robust config of the other install"
		robust=$2
		shift 2
		;;
	--robust=*) robust=${1#*=}; shift ;;
	--nick)
		(($# > 1)) || die "--nick requires a nick"
		nick=$2
		shift 2
		;;
	--nick=*) nick=${1#*=}; shift ;;
	--switch) switch=true; shift ;;
	--simulator)
		(($# > 1)) || die "--simulator requires the config of the simulator"
		files+=("$2")
		shift 2
		;;
	--simulator=*) files+=("${1#*=}"); shift ;;
	--grid-settings)
		(($# > 1)) || die "--grid-settings requires the OpenSim.ini of the other grid"
		settings=$2
		shift 2
		;;
	--grid-settings=*) settings=${1#*=}; shift ;;
	--name)
		(($# > 1)) || die "--name requires a name"
		name=$2
		shift 2
		;;
	--name=*) name=${1#*=}; shift ;;
	--core)
		(($# > 1)) || die "--core requires a folder"
		core=$2
		shift 2
		;;
	--core=*) core=${1#*=}; shift ;;
	--apply) mode=apply; shift ;;
	--no-scripts) scripts=false; shift ;;
	-*) die "unknown option $1 (usage: $USAGE)" ;;
	*)
		[[ -z "$grid" ]] || die "one grid only (usage: $USAGE)"
		grid=$1
		shift
		;;
	esac
done
# A grid of another install, migrated: the same grid, its config made here, its simulators with it; switched once the old one is stopped
if [[ -n "$robust" ]]; then
	[[ -z "$grid$settings$accounts$name" ]] || die "usage: $USAGE"
	[[ -r "$robust" ]] || die "cannot read $robust"
	paths=()
	for file in ${files[@]+"${files[@]}"}; do
		[[ -r "$file" ]] || die "cannot read $file"
		paths+=("$(realpath "$file")")
	done
	request=$(jq -cn --arg file "$(realpath "$robust")" --arg nick "$nick" --arg core "$core" --arg mode "$mode" --argjson switch "$switch" --argjson scripts "$scripts" \
		'{data: {type: "imports", attributes: ({kind: "robust", file: $file, mode: $mode, switch: $switch, simulators: ($ARGS.positional | map({file: .} + (if $scripts then {} else {scripts: false} end)))} + ({nick: $nick, core: $core} | with_entries(select(.value != ""))))}}' \
		--args ${paths[@]+"${paths[@]}"})
	reply=$(engine POST /setups/imports --data=- <<<"$request") || true
	jq -e '.data.attributes' <<<"$reply" >/dev/null 2>&1 ||
		die "$(jq -r 'if .detail then .detail else (.title // "the engine did not answer") end' <<<"$reply" 2>/dev/null || printf '%s' "$reply")"
	jq -r '
		def said: if type == "object" then .detail else . end;
		.data.attributes |
		"Grid \(.name) (\(.grid)), from \(.source)",
		"Config:   \(.config)",
		"Database: \(.database.name) @ \(.database.host) (user \(.database.user)), kept as it is",
		"Ports:    public \(.ports.public), private \(.ports.private)" + (if .ports.console then ", console \(.ports.console)" else "" end),
		"Settings kept: \(.settings | length)",
		((.settings // [])[] | "  [\(.section)] \(.key) = \(.value)"),
		"Settings left: \((.dropped // []) | length)" + (if ((.dropped // []) | length) > 0 then " (" + (.dropped | group_by(.reason) | map("\(.[0].reason) \(length)") | join(", ")) + ")" else "" end),
		(if .backup then "Backup of the source first: \(.backup.file) (databases \(.backup.databases | join(", ")))" else empty end),
		(if ((.simulators.steps // []) | length) > 0 then "Simulators: " + (.simulators.steps | map("\(.simulator) (\(.slug))") | join(", ")) else empty end),
		(if ((.problems // {}) | length) > 0 then "Problems, nothing can be written:", (.problems | to_entries[] | "  \(.key): \(.value)") else empty end),
		"",
		(if .applied then "Written:" else "Would write:" end),
		((.writes // [])[] | "  \(.)"),
		(if .applied then "Report:   \(.report)" elif .switched then empty else "Nothing was written: add --apply to write it." end),
		(if .switched then "Started: \(.started | join(", "))" else ((.reminders // [])[] | "- \(said)") end)' <<<"$reply"
	jq -e '(.data.attributes.problems // {}) | length == 0' <<<"$reply" >/dev/null
	exit
fi
# The accounts of a list (- : from the standard input, as the command line sends the file of its caller): what is done on the error
# output, the result (with the passwords made here) on the standard output once applied, for the caller to keep
if [[ -n "$accounts" ]]; then
	[[ -n "$grid" ]] && ((${#files[@]} == 0)) && [[ -z "$settings" ]] || die "usage: $USAGE"
	if [[ "$accounts" == - ]]; then
		text=$(cat)
	else
		[[ -r "$accounts" ]] || die "cannot read $accounts"
		text=$(<"$accounts")
	fi
	request=$(jq -cn --arg text "$text" --arg grid "$grid" --arg mode "$mode" --arg format "$format" --argjson keep "$keep" \
		'{data: {type: "imports", attributes: ({kind: "accounts", text: $text, grid: $grid, mode: $mode, keepGoing: $keep} + (if $format != "" then {format: $format} else {} end))}}')
	reply=$(engine POST /setups/imports --data=- <<<"$request") || true
	jq -e '.data.attributes' <<<"$reply" >/dev/null 2>&1 ||
		die "$(jq -r 'if .detail then .detail else (.title // "the engine did not answer") end' <<<"$reply" 2>/dev/null || printf '%s' "$reply")"
	jq -r '.data.attributes |
		(.errors[] | "import: \(.)"),
		(.results[] | "\(.status)\(" " * (14 - (.status | length))) \(.first) \(.last)" + (if .detail != "" then " (\(.detail))" else "" end)),
		"",
		(.counts | to_entries | map("\(.value) \(.key)") | join(", ")),
		(if .applied then empty else "Nothing was written: --apply makes the accounts." end)' <<<"$reply" >&2
	jq -r '.data.attributes.csv // empty' <<<"$reply"
	# A line that cannot be used, an account that failed or was not tried: an error
	jq -e '.data.attributes | (.errors | length) == 0 and ((.counts.failed // 0) + (.counts["not tried"] // 0)) == 0' <<<"$reply" >/dev/null
	exit
fi
# The settings of a grid of another install, into the OpenSim.ini of a grid of this machine
if [[ -n "$settings" ]]; then
	[[ -n "$grid" ]] && ((${#files[@]} == 0)) || die "usage: $USAGE"
	[[ -r "$settings" ]] || die "cannot read $settings"
	request=$(jq -cn --arg file "$(realpath "$settings")" --arg grid "$grid" --arg mode "$mode" '{data: {type: "imports", attributes: {kind: "grid-settings", file: $file, grid: $grid, mode: $mode}}}')
	reply=$(engine POST /setups/imports --data=- <<<"$request") || true
	jq -e '.data.attributes' <<<"$reply" >/dev/null 2>&1 ||
		die "$(jq -r 'if .detail then .detail else (.title // "the engine did not answer") end' <<<"$reply" 2>/dev/null || printf '%s' "$reply")"
	# The plan, or what was written: the values as the engine says them, a secret masked
	jq -r '.data.attributes |
		"Settings of the grid \(.grid), from \(.source)",
		(if ((.files // {}) | length) == 0 then "Nothing to bring: the grid has them already." else ((.files // {}) | to_entries[] | "Into \(.key):", (.value | to_entries[] | .key as $section | .value | to_entries[] | "  [\($section)] \(.key) = \(.value)")) end),
		(.notes[] | "- \(.)"),
		"",
		(if .applied then "Written to \((.files // {}) | keys | join(", "))", "Then the repair of the options lays them in its simulators (at the next upgrade of the packages, or now: opensim api POST /grids/\(.grid)/options/repair mode=apply)" elif ((.files // {}) | length) > 0 then "Nothing was written: add --apply to write it." else empty end)' <<<"$reply"
	exit
fi
# A setup file: the one word given, without --simulator
if ((${#files[@]} == 0)); then
	[[ -n "$grid" && -r "$grid" ]] || die "usage: $USAGE"
	setup_file "$grid" "$mode"
	exit
fi
[[ -n "$grid" ]] || die "usage: $USAGE"
((${#files[@]} == 1)) || [[ -z "$name$core" ]] || die "--name and --core are for one simulator (usage: $USAGE)"
paths=()
for file in "${files[@]}"; do
	[[ -r "$file" ]] || die "cannot read $file"
	paths+=("$(realpath "$file")")
done

if ((${#paths[@]} == 1)); then
	request=$(jq -cn --arg file "${paths[0]}" --arg grid "$grid" --arg name "$name" --arg core "$core" --arg mode "$mode" --argjson scripts "$scripts" \
		'{data: {type: "imports", attributes: ({kind: "simulator", file: $file, grid: $grid, mode: $mode} + ({name: $name, core: $core} | with_entries(select(.value != ""))) + (if $scripts then {} else {scripts: false} end))}}')
else
	request=$(jq -cn --arg grid "$grid" --arg mode "$mode" --argjson scripts "$scripts" '{data: {type: "imports", attributes: {kind: "simulator", grid: $grid, mode: $mode, simulators: ($ARGS.positional | map({file: .} + (if $scripts then {} else {scripts: false} end)))}}}' --args "${paths[@]}")
fi
reply=$(engine POST /setups/imports --data=- <<<"$request") || true
jq -e '.data.attributes' <<<"$reply" >/dev/null 2>&1 ||
	die "$(jq -r 'if .detail then .detail else (.title // "the engine did not answer") end' <<<"$reply" 2>/dev/null || printf '%s' "$reply")"

# The plan, or what was written: what the engine says, as lines (several simulators: each, then what is wrong between them)
jq -r '
	def said: if type == "object" then .detail else . end;
	def step:
		"Simulator \(.simulator) (\(.slug)) of the grid \(.grid), from \(.source)",
		"Config:   \(.config)",
		"Database: \(.database.name) @ \(.database.host) (user \(.database.user)), kept as it is",
		"Ports:    http \(.ports.http)" + (if .ports.console then ", console \(.ports.console)" else "" end),
		"Regions:  \(.regions | length)",
		(.regions[] | "  \(.name) (\(.uuid), \(.location)): \(.file) -> \(.to)"),
		(if .backup then "Backup of the source first: \(.backup.file) (databases \(.backup.databases | join(", ")), \(.backup.files | length) files)" else empty end),
		(if .scripts then (if .scripts.copied then "State of the scripts: \(.scripts.from | join(", ")) -> \(.scripts.to) (\(.scripts.size) bytes)" elif (.scripts.from | length) > 0 then "State of the scripts: not copied, every script starts again" else empty end) else empty end),
		"Settings kept: \(.settings | length)",
		(if .dropped then "Settings left: \(.dropped | length)" + (if (.dropped | length) > 0 then " (" + (.dropped | group_by(.reason) | map("\(.[0].reason) \(length)") | join(", ")) + ")" else "" end) else empty end),
		((.dropped // [])[] | select(.reason == "replaced") | "  [\(.section)] \(.key) = \(.value)" + (if .replacement then " -> \(.replacement)" else ": written by the new config its own way" end));
	.data.attributes |
	if .steps then
		(.steps[] | step, ""),
		(if (.problems | length) > 0 then "Problems, nothing can be written:", (.problems | to_entries[] | "  \(.key): \(.value)") else empty end),
		(if .applied then "Written:" else "Would write:" end),
		(.writes[] | "  \(.)"),
		"",
		(if .applied then empty else "Nothing was written: add --apply to write it." end),
		(.reminders[] | "- \(said)")
	else
		step,
		(if .applied then "Written:" else "Would write:" end),
		(.writes[] | "  \(.)"),
		"",
		(if .applied then "Report:   \(.report)" else "Nothing was written: add --apply to write it." end),
		(.reminders[] | "- \(said)")
	end' <<<"$reply"
# Several simulators that cannot be written together end in an error
jq -e '(.data.attributes.problems // {}) | length == 0' <<<"$reply" >/dev/null

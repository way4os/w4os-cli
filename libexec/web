#!/usr/bin/env bash
# opensim web: show, check, or print web-server snippets for a grid.

USAGE="opensim web [GRID] [show|check|snippet caddy|nginx|apache|set PAGE URL] [options]"
HELP="Show grid web services and who serves each page (the helpers under their base, the site elsewhere), check their URLs, print a server snippet, or set the address of a page (helpers, search, profile, guide, welcome, status, directory). Options: --docroot DIR, --socket PATH."

source "$(dirname "$(realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")/../src/lib/common"

run web "$@"

#!/usr/bin/env bash
# opensim simulator add: a simulator made in a grid of this machine with its first region, through the engine (a setup file of one
# simulator).

USAGE="opensim simulator add GRID NAME --region NAME [--location X,Y] [--size METERS] [--roles ROLE,...] [--http-port PORT] [--owner 'First Last'] [--apply]"
HELP="Makes the simulator NAME in the grid GRID, with its first region. Its database is the one of the environment (OPENSIM_DB_HOST, OPENSIM_DB_USER, OPENSIM_DB_PASS), made when it is missing; its estate is owned by --owner (an account of the grid). What is not given is proposed by the engine: its ports, the nearest free place. Without --apply, says what would be written and where, and writes nothing. Nothing is started: opensim start, once it is written."

source "$(dirname "$(realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")/../src/lib/common"

[[ "${1:-}" == add ]] || die "usage: $USAGE"
shift
words=() region= location= size= roles= http_port= owner= mode=plan
while (($#)); do
	case "$1" in
	--region | --location | --size | --roles | --http-port | --owner)
		(($# > 1)) || die "$1 requires a value"
		key=${1#--}
		printf -v "${key//-/_}" '%s' "$2"
		shift 2
		;;
	--apply) mode=apply; shift ;;
	-*) die "unknown option $1 (usage: $USAGE)" ;;
	*) words+=("$1"); shift ;;
	esac
done
((${#words[@]} == 2)) && [[ -n "$region" ]] || die "usage: $USAGE"

setup=$(jq -cn --arg grid "${words[0]}" --arg simulator "${words[1]}" --arg region "$region" --arg location "$location" --arg size "$size" --arg roles "$roles" --arg http_port "$http_port" --arg owner "$owner" \
	--arg host "${OPENSIM_DB_HOST:-}" --arg user "${OPENSIM_DB_USER:-}" --arg password "${OPENSIM_DB_PASS:-}" \
	'{grid: {nick: $grid}, simulators: [{name: $simulator}
		+ (if $http_port != "" then {http_port: ($http_port | tonumber)} else {} end)
		+ (if $owner != "" then {estate: {owner: $owner}} else {} end)
		+ {database: ({host: $host, user: $user, password: $password} | with_entries(select(.value != "")))}
		+ {regions: [{name: $region}
			+ (if $location != "" then {location: $location} else {} end)
			+ (if $size != "" then {size: ($size | tonumber)} else {} end)
			+ (if $roles != "" then {roles: ($roles | split(","))} else {} end)]}]}') || die "--size and --http-port are numbers"
reply=$(jq -cn --argjson setup "$setup" --arg mode "$mode" '{data: {type: "files", attributes: {setup: $setup, mode: $mode}}}' | engine POST /setups/files --data=-) || true
setup_file_report "$reply"

#!/usr/bin/env bash
# opensim restart: Stops, then starts grids (with their simulators) and simulators.

USAGE="opensim restart [-hqv] [--robust] [now] [target...]"
HELP="Stops, then starts grids (with their simulators) and simulators. --robust: the Robust of a grid alone."

source "$(dirname "$(realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")/../src/lib/common"

run restart "$@"

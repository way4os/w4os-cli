[Unit]
Description=Backup of the OpenSim grids of this machine
After=opensim.service

[Service]
Type=oneshot
# The default account: the one of the install (SystemUser of /etc/w4os/w4os.conf) is set by w4os-system-user.conf in
# the folder of drop-ins of this unit, which the engine writes
User=opensim
Group=opensim
WorkingDirectory=~
ExecStart=/usr/bin/opensim backup --keep 14
Nice=10
IOSchedulingClass=idle

[Unit]
Description=OpenSimulator instances
Documentation=https://github.com/way4os/w4os-cli
After=network-online.target mariadb.service mysql.service
Wants=network-online.target

[Service]
# The main process is the launch master: it listens on /run/opensim/launch.sock, and what it starts, whoever asks (a shell, the
# engine API, the start at boot), is the service's and stops with it. It is ready once it listens
Type=notify
NotifyAccess=all
User=opensim
Group=opensim
WorkingDirectory=~
RuntimeDirectory=opensim
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/opensim service
# The enabled instances, Robust first, each once the one before is up: one that does not start leaves the others running
ExecStartPost=-/usr/bin/opensim start
# The instances stopped in order, the simulators before their Robust, each within a minute, before the master ends
ExecStop=/usr/bin/opensim stop now
TimeoutStartSec=30min
TimeoutStopSec=15min

[Install]
WantedBy=multi-user.target
